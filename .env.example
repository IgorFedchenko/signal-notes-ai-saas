# npm run demo generates local-only credentials automatically. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
APP_URL=http://127.0.0.1:3210
# fixture = deterministic extractive summaries, no network and no cost.
AI_PROVIDER=fixture
# Optional: owner-approved key only. No live LLM calls in CI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Test mode only. Live Stripe keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
