# npm run demo generates local-only credentials automatically. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
APP_URL=http://127.0.0.1:3210
# fixture = deterministic extractive summaries, no network and no cost.
AI_PROVIDER=fixture
# Optional: owner-approved key only. No live LLM calls in CI.
OPENAI_API_KEY=
# Reference snapshot/rates are dated in src/lib/ai/pricing.ts; reverify before consent.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
AI_LIVE_APPROVED=false
AI_INPUT_BYTE_CAP=65536
AI_OUTPUT_TOKEN_CAP=800
# Optional self-hosted Phoenix; unset means export disabled.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Test mode only. Live Stripe keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
